# Скопируйте этот файл в .env и впишите ключи. Файл .env в git не попадает.
# Если рядом лежит папка dm-model-test с keys.bat, start.bat возьмёт ключи оттуда сам.

# mock — заглушка без ИИ и без расходов; yandex — настоящий мастер через Yandex AI Studio
AI_MODE=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Модели (по итогам теста 07.10.2026). Для «эпичного» рассказчика: NARRATOR_MODEL=aliceai-llm
ARBITER_MODEL=aliceai-llm-flash
NARRATOR_MODEL=aliceai-llm-flash
# Цены в рублях за 1000 токенов — для подсчёта расходов
ARBITER_PRICE_IN=0.1
ARBITER_PRICE_OUT=0.2
ARBITER_PRICE_CACHED=0.025
NARRATOR_PRICE_IN=0.1
NARRATOR_PRICE_OUT=0.2
NARRATOR_PRICE_CACHED=0.025

PORT=8080
# Энергия: стартовый запас, ежедневное пополнение, потолок пополнения, цена хода
ENERGY_START=50
ENERGY_DAILY=30
ENERGY_CAP=50
ENERGY_PER_TURN=1
